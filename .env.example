# Banco de dados (Docker Compose)
POSTGRES_USER=atjewel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=atjewel_dev

# Banco de dados (local sem Docker)
DATABASE_URL=postgresql://atjewel:changeme@localhost:5432/atjewel_dev

# Aplicacao
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

# CORS - lista separada por virgula, sem espacos
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (auth admin)
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_random_hex
# TTL do access token (formato do jsonwebtoken: 15m, 1h, 8h, 1d...). Default 8h.
JWT_ACCESS_TTL=8h

# Criptografia de PII (AES-256-GCM) - 32 bytes em hex (64 chars)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_random_hex_32_bytes

# Hash HMAC-SHA256 para campos *_hash
# IMPORTANTE: chave DIFERENTE da ENCRYPTION_KEY
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SECRET=replace_with_random_hex_32_bytes

# Integracao ERP Safira
SAFIRA_API_KEY=replace_with_real_key

# Agentes internos (Anastasia-analytics / Elena-catalogo) via Anthropic SDK.
# Sem a chave, os endpoints /agentes/*/chat respondem 500 (os demais funcionam).
ANTHROPIC_API_KEY=replace_with_anthropic_key
# Modelos por agente (defaults se ausentes: opus-4-8 / sonnet-4-6)
ANTHROPIC_MODEL_ANASTASIA=claude-opus-4-8
ANTHROPIC_MODEL_ELENA=claude-sonnet-4-6
# O leitor de conversas do numero corporativo (MEL-15). Extrai quatro campos
# de um trecho de conversa — nao conversa com ninguem. Modelo menor basta:
# extrair nao e conversar. Vazio usa claude-sonnet-5.
ANTHROPIC_MODEL_LEITOR=claude-sonnet-5

# Login com Google (OIDC). Client ID do OAuth 2.0 criado no Google Cloud
# Console (tipo "Aplicativo Web"). Vazio = login Google desabilitado.
# Deve ser igual ao NEXT_PUBLIC_GOOGLE_CLIENT_ID do front.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# Transcricao de audio (OpenAI). A vendedora manda audio no WhatsApp e a
# gerencia grava no painel; o audio vira texto e segue como mensagem digitada.
# Sem a chave, audio e ignorado com aviso — o resto do sistema nao muda.
OPENAI_API_KEY=replace_with_openai_key
# Modelo de transcricao. Default: gpt-4o-mini-transcribe. Medido em 21/08/2026,
# o modelo MAIOR (gpt-4o-transcribe) errou onde este acertou, e demorou o dobro.
OPENAI_TRANSCRICAO_MODEL=gpt-4o-mini-transcribe

# WhatsApp — os DOIS numeros da casa (25/09/2026).
# WAHA_SESSION e a sessao da Anastasia (gestao), a historica.
# WAHA_SESSION_ELENA e a das vendedoras e do catalogo. AUSENTE = um numero so,
# que atende todo mundo, exatamente como antes. Configure so quando o segundo
# chip estiver pronto para ler o QR — ver SessoesDaCasaService.
WAHA_SESSION=default
# WAHA_SESSION_ELENA=elena

# ---------------------------------------------------------------------------
# TETO DE ENVIO PELO WHATSAPP (RF-12, 28/09/2026).
#
# NAO E o que impede disparo em massa — isso e nao existir caminho para ele.
# Isto aqui e a rede embaixo, contra envio em lote ACIDENTAL: laco que nao
# termina, retry sem teto, fila represada despejando de uma vez.
#
# Por que importa: conta de WhatsApp e bloqueada por volume, as vezes em
# definitivo, e junto vao os contatos e as conversas.
#
# Os valores abaixo sao os PADROES — nao precisa configurar nada para o limite
# valer. Mexa so se a operacao crescer, e desconfie antes de aumentar: chegar
# no teto quase sempre e defeito, nao demanda. Valor invalido ou zero cai no
# padrao, e nunca em "bloqueia tudo" — ver LimiteDeEnvioService.
#
# WHATSAPP_LIMITE_POR_DESTINO=30   # mensagens para a MESMA pessoa na janela
# WHATSAPP_LIMITE_POR_NUMERO=300   # mensagens pelo mesmo chip na janela
# WHATSAPP_JANELA_MINUTOS=60       # o tamanho da janela
